# Copy this file to .env and fill in your real values
# .env is gitignored. Never commit real credentials.

# AWS
AWS_REGION=eu-west-1
AWS_S3_BUCKET=travel-forecast-yourname
SAGEMAKER_ROLE_ARN=arn:aws:iam::YOUR_ACCOUNT_ID:role/SageMakerRole

# Project
PROJECT_NAME=travel-demand-forecasting
MODEL_PACKAGE_GROUP=TravelDemandForecasting

# Drift detection
PSI_THRESHOLD=0.2

# Forecasting
FORECAST_HORIZON_WEEKS=26
TEST_SIZE_WEEKS=12
